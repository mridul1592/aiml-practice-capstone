# LLM Configuration
LLM_PROVIDER=ollama  # Options: openai, ollama, huggingface
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat  # or llama2, mistral, etc.
OPENAI_API_KEY=your_openai_key_here

# Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Vector Store Configuration
FAISS_INDEX_PATH=./data/embeddings/faiss_index.bin
METADATA_INDEX_PATH=./data/embeddings/metadata.json

# RAG Configuration
CHUNK_SIZE=200
CHUNK_OVERLAP=40
SIMILARITY_THRESHOLD=0.5
TOP_K_RETRIEVAL=5
LANGUAGE_DETECT_THRESHOLD=0.5

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Streamlit Configuration
STREAMLIT_PORT=8501

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
