# LLM Configuration
LLM_PROVIDER=ollama  # Options: openai, ollama, huggingface
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # or llama2, neural-chat, etc.
OPENAI_API_KEY=your_openai_key_here

# Embedding Configuration
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Vector Store Configuration
FAISS_INDEX_PATH=./data/embeddings/faiss_index.bin
METADATA_INDEX_PATH=./data/embeddings/metadata.json

# Reranker Configuration
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base

# RAG Configuration
CHUNK_SIZE=200
CHUNK_OVERLAP=40
SIMILARITY_THRESHOLD=0.5
TOP_K_RETRIEVAL=5
LANGUAGE_DETECT_THRESHOLD=0.5
# SUPPORTED_LANGUAGES=["en","hi","pa"]   # override with JSON array if needed

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Streamlit Configuration
STREAMLIT_PORT=8501

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
